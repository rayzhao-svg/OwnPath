{
  "name": "ownpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:enhancements": "node scripts/enhancement-smoke.mjs",
    "test:integration": "node scripts/integration.cjs",
    "test:journey": "node scripts/journey-ui.cjs",
    "test:quiz": "node scripts/quiz-refresh.cjs && node scripts/quiz-history.cjs && node scripts/quiz-ui.cjs",
    "test:resources": "node scripts/lesson-resources.cjs",
    "test:learning-track": "node scripts/learning-track.cjs",
    "test:lesson-detail": "node scripts/lesson-detail.cjs && node scripts/lesson-detail-state.cjs",
    "test:narration": "node scripts/narration-api.cjs && node scripts/neural-narration.cjs && node scripts/narration-voice.cjs",
    "test:phase4": "node scripts/phase4-integration.cjs",
    "test:phase4:smoke": "node scripts/phase4-smoke.mjs",
    "test:resume": "node scripts/resume.cjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
