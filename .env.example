# Server-only. This placeholder keeps /api/plan in mock mode.
# Copy to .env.local, replace the placeholder, then restart npm run dev.
ANTHROPIC_API_KEY=YOUR_API_KEY_HERE

# Optional server-only Azure Speech credentials for Amanda Multilingual narration.
# Use the region matching the Speech resource, then restart the development server.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Optional server-only persistent account database (default .data/ownpath.sqlite).
# Use a private durable disk path when deploying accounts.
# OWNPATH_DATABASE_PATH=/absolute/private/path/ownpath.sqlite
